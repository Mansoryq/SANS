PROJECT_NAME="Smart Airport Notification System (SANS)"
VERSION="2.0.0"
API_V1_STR="/api"
ENVIRONMENT="production"

# Database
DATABASE_URL="postgresql://postgres:postgres@db:5432/sans_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Redis / Upstash Cache
REDIS_URL="redis://localhost:6379/0"

# Security
SECRET_KEY="sans-enterprise-secret-key-32bytes-long!"
ENCRYPTION_KEY="uH8-Xl0r2-j-9K1r_yv_P9M9M9M9M9M9M9M9M9M9M9M="
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Polling & Worker
DEFAULT_POLL_INTERVAL=20
MAX_NOTIFICATION_RETRIES=5

# Observability (Sentry)
SENTRY_DSN=""

# Analytics (PostHog)
ANALYTICS_ENABLED="True"
