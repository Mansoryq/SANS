PROJECT_NAME="Smart Airport Notification System (SANS)"
VERSION="2.0.0"

# Environment
ENVIRONMENT="development"

# Database (Supabase PostgreSQL / Local Postgres)
DATABASE_URL="postgresql://postgres:postgres@db:5432/sans_db"

# Connection Pooling Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Redis / Upstash Cache
REDIS_URL="redis://localhost:6379/0"

# Security (Change these in production!)
SECRET_KEY="replace-this-with-a-secure-random-string"
ENCRYPTION_KEY="replace-this-with-base64-32-byte-key="

# Supabase Storage (Optional for file uploads)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# Observability (Sentry)
SENTRY_DSN=""

# Analytics (PostHog)
ANALYTICS_ENABLED="True"
POSTHOG_API_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# Polling & Workers
DEFAULT_POLL_INTERVAL=20
MAX_NOTIFICATION_RETRIES=5
